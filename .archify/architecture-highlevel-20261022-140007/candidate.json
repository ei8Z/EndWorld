  "cards": [
    {
      "dot": "cyan",
      "title": "主请求路径",
      "items": [
        "UI → ViewModel → Repository → Prompt → 裁决 Agent → Repository → 叙事 Agent → ViewModel",
        "裁决结果由 Repository 应用，流式事件经 callbackFlow 回传",
        "Room Flow 驱动 UI 刷新；重试与降级在 ViewModel"
      ]
    },
    {
      "dot": "emerald",
      "title": "世界模拟与结算",
      "items": [
        "跨午夜时 settleUntil 逐日推进，成功才前移游标",
        "每日结算含资源、战斗、场景 3/5/6、NPC 互动与 KEY 提升",
        "V3 六表由 V3WorldStateStore 单事务写入 Room"
      ]
    },
    {
      "dot": "rose",
      "title": "权威与信任边界",
      "items": [
        "HP/SP/背包/时间以状态机 postSnapshot 为权威",
        "AI 只提供增量与软数据，不直接写数值",
        "release 不做破坏性迁移回退；Room 为 v12 / 12 实体"
      ]
    },
    {
      "dot": "amber",
      "title": "死亡与续局",
      "items": [
        "HP/饥渴归零进入死亡层；「重新开始」清空本局并轮换 stable_user_id",
        "「继承世界」保留势力/NPC/关系，重置角色/背包/时间，好感 ×0.3",
        "前代纪事仅展示 story_history 最近 10 条，不进 prompt/MemOS"
      ]
    },
    {
      "dot": "slate",
      "title": "支持组件（不单独连线）",
      "items": [
        "GameConfigLoader / WorldInitializer：配置与默认世界",
        "DependencyContainer：手写单例 DI；UIModeManager：界面模式",
        "ToolRegistry：check_inventory 防幻觉对账",
        "WorldStoryteller：加速退出摘要；SettlementLedger：逐日游标"
      ]
    }
  ]
}